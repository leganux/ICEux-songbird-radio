APP_NAME=ICEux Songbird Radio
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-value
DATABASE_URL=sqlite:///./data/iceux.db
APP_PORT=8000
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=/radio
ICECAST_PUBLIC_PORT=8001
ICECAST_USERNAME=source
ICECAST_PASSWORD=change-me-source-password
ICECAST_ADMIN_PASSWORD=change-me-admin-password
ICECAST_RELAY_PASSWORD=change-me-relay-password
ICECAST_PUBLIC_HOST=localhost
ICECAST_FORMAT=mp3
ICECAST_BITRATE=128
LIQUIDSOAP_HOST=liquidsoap
LIQUIDSOAP_PORT=1234
LIQUIDSOAP_SOCKET=/run/iceux/liquidsoap.sock
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=iceux-admin
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=iceux-radio
S3_REGION=
S3_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
SCRIPT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_API_KEY=
GOOGLE_API_KEY=
N8N_WEBHOOK_SECRET=
